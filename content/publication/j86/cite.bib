AUTHOR = {Heidari, Roghayeh and Khanmohammadi, Reza and Samavati, Faramarz F.},
TITLE = {The Evolution of Data-Driven Management Zone Delineation: A Systematic Review},
JOURNAL = {Sensors},
VOLUME = {26},
YEAR = {2026},
NUMBER = {10},
